    "req": {
        "id": "reference_id_00001"
    },
    "image": {
        "isGen": true,
        "isGenRoi": true
    },
    "pdf": {
        "pages":[],
        "template": {
            "name": "koelnmesse",
            "engine": "text",
            "ver": 1,
            "static": [
                {
                    "pageNo": 0,
                    "pageWidth": 763,
                    "pageHeight": 1080,
                    "fields": [
