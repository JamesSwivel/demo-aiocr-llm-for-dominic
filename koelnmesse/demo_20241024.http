                            "tolerance": 80,
                            "delimiter": "",
                            "isKeepNewLine": false
                        }
                    ]
                },
                {
                    "pageNo": 1,
                    "pageWidth": 763,
                    "pageHeight": 1080,
                    "fields": [
                        {
                            "key": "invoiceNo",
                            "offsetRelativeTo": "page",
                            "offset": [543, 252],
                            "width": 70,
                            "height": 16,
                            "tolerance": 80,
                            "delimiter": "",
                            "isKeepNewLine": false
                        },
                        {
                            "key": "event",
                            "offsetRelativeTo": "page",
                            "offset": [47, 451],
                            "width": 475,
                            "height": 22,
                            "tolerance": 80,
                            "delimiter": "",
                            "isKeepNewLine": false                            
                        },
                        {
                            "key": "custNo",
                            "offsetRelativeTo": "page",
                            "offset": [544, 288],
                            "width": 80,
                            "height": 17,
                            "tolerance": 80,
                            "delimiter": "",
                            "isKeepNewLine": false    
                        },
                        {
                            "key": "hall",
                            "offsetRelativeTo": "page",
                            "offset": [49, 480],
                            "width": 195,
                            "height": 18,
                            "tolerance": 80,
                            "delimiter": "",
                            "isKeepNewLine": false    
                        },
                        {
                            "key": "orderNo/Date",
                            "offsetRelativeTo": "page",
                            "offset": [544, 324],
                            "width": 115,
                            "height": 19,
                            "tolerance": 80,
                            "delimiter": "",
                            "isKeepNewLine": false    
                        },
                        {
                            "key": "custName",
                            "offsetRelativeTo": "page",
                            "offset": [47, 571],
                            "width": 485,
                            "height": 18,
                            "tolerance": 80,
                            "delimiter": "",
                            "isKeepNewLine": false    
                        }
                    ]
                }
            ],
            "tables": [
                {
                    "key": "table",
                    "pageWidth": 763,
                    "pageHeight": 1080,
                    "startAnchor": {
                        "anchorType": "table",
                        "topLeftX": 50,
                        "text": "Description",
                        "yOffset": 28
                    },
                    "endAnchor": {
                        "anchorType": "table",
                        "topLeftX": 50,
                        "text": "Net amount",
                        "yOffset": 28
                    },
                    "conditionColAlign": "bottom",
                    "ignoreHeightFromTop": 250,
                    "ignoreHeightFromBottom": 0,
                    "cols": [
                        {
                            "key": "totalPrice",
                            "colType": "condition",
                            "leftX": 437,
                            "width": 100,
                            "extractMode": "inRoi",
                            "contain": {
                                "type": "text",
                                "value": ""
                            },
                            "delimiter": "",
                            "isKeepNewLine": false,
                            "tolerance": 80
                        },
                        {
                            "key": "unitPrice",
                            "colType": "simple",
                            "leftX": 369,
                            "width": 65,
                            "delimiter": "",
                            "isKeepNewLine": false,
                            "tolerance": 80
                        },
                        {
                            "key": "qty",
