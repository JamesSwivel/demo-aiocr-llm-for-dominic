                            "leftX": 256,
                            "width": 42,
                            "delimiter": "",
                            "isKeepNewLine": false,
                            "tolerance": 80
                        },
                        {
                            "key": "description",
                            "colType": "simple",
                            "leftX": 50,
                            "width": 206,
                            "delimiter": "",
                            "isKeepNewLine": true,
                            "tolerance": 25
                        }
                    ]
                }
            ]
        }
    }
